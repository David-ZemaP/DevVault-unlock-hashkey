{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "lib",
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["lib/**/*.ts"]
}
